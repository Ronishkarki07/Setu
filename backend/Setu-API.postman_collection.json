          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/tickets/1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "tickets", "1"]
            },
            "description": "Get a specific ticket by ID"
          },
          "response": []
        },
        {
          "name": "Update Ticket",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated ticket title\",\n  \"description\": \"Updated description\",\n  \"status\": \"In Progress\",\n  \"priority\": \"Medium\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/tickets/1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "tickets", "1"]
            },
            "description": "Update an existing ticket"
          },
          "response": []
        },
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"This is a comment on the ticket\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/tickets/1/comments",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "tickets", "1", "comments"]
            },
            "description": "Add a comment to a ticket"
          },
          "response": []
        },
        {
          "name": "Delete Ticket",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/tickets/1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "tickets", "1"]
            },
            "description": "Delete a ticket"
          },
          "response": []
        }
      ]
    }
